{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MTX APPLICABILITY DECISION v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "decisions"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "enum": [
        "BATCH-1",
        "BATCH-2",
        "BATCH-3",
        "BATCH-4",
        "BATCH-5",
        "BATCH-6",
        "BATCH-7",
        "BATCH-8",
        "BATCH-9",
        "BATCH-10",
        "BATCH-11",
        "BATCH-12",
        "BATCH-13",
        "BATCH-14",
        "BATCH-15",
        "BATCH-16",
        "BATCH-17",
        "BATCH-18",
        "BATCH-19",
        "BATCH-20",
        "BATCH-21",
        "BATCH-22",
        "BATCH-23",
        "BATCH-24"
      ]
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "applicability",
          "rationale",
          "scope",
          "adaptations",
          "limitations",
          "mtx_derived",
          "channels"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^MS002-SRC-[ABC]\\|(R|WF|AP)-[0-9]{4}$"
          },
          "applicability": {
            "enum": [
              "DIRECT_USE",
              "ADAPT_TO_MTX",
              "REFERENCE_ONLY",
              "REJECT",
              "NOT_YET_CLASSIFIED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 20
          },
          "scope": {
            "type": "string",
            "minLength": 5
          },
          "adaptations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mtx_derived": {
            "type": "boolean"
          },
          "derivation": {
            "type": [
              "string",
              "null"
            ]
          },
          "channels": {
            "type": "array",
            "items": {
              "enum": [
                "instagram",
                "whatsapp",
                "google_ads",
                "email",
                "sms",
                "voz",
                "none"
              ]
            }
          }
        }
      }
    }
  }
}