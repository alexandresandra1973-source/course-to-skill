{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MS-001B RELATION JUDGMENT v1",
  "type": "object", "additionalProperties": false,
  "required": ["batch_id", "judgments"],
  "properties": {
    "batch_id": {"type": "string", "pattern": "^BATCH-[1-4]$"},
    "judgments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "relation", "direction", "scope_state", "relation_why",
                     "left_evidence_refs_checked", "right_evidence_refs_checked"],
        "properties": {
          "pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "relation": {"enum": ["IDENTICAL","CORROBORATES","SPECIALIZES","CONTRADICTS",
                                "SUPERSEDES","UNRELATED","INDETERMINATE"]},
          "direction": {"enum": ["NONE","LEFT_TO_RIGHT","RIGHT_TO_LEFT"]},
          "scope_state": {"enum": ["EQUIVALENT_SCOPE","NESTED_COMPATIBLE_SCOPE",
                                   "DIFFERENT_SCOPE","AMBIGUOUS_SCOPE"]},
          "relation_why": {"type": "string", "minLength": 15},
          "left_evidence_refs_checked": {"type":"array","minItems":1,
            "items":{"type":"string","pattern":"^EV-[0-9]{4}$"}},
          "right_evidence_refs_checked": {"type":"array","minItems":1,
            "items":{"type":"string","pattern":"^EV-[0-9]{4}$"}}
        }
      }
    }
  },
  "direction_compatibility_MECANICA": {
    "IDENTICAL": ["NONE"], "CORROBORATES": ["NONE"], "CONTRADICTS": ["NONE"],
    "UNRELATED": ["NONE"], "INDETERMINATE": ["NONE"],
    "SPECIALIZES": ["LEFT_TO_RIGHT","RIGHT_TO_LEFT"],
    "SUPERSEDES": ["LEFT_TO_RIGHT","RIGHT_TO_LEFT"]
  },
  "scope_compatibility_MECANICA": {
    "IDENTICAL": ["EQUIVALENT_SCOPE"],
    "SPECIALIZES": ["NESTED_COMPATIBLE_SCOPE","EQUIVALENT_SCOPE"],
    "CONTRADICTS": ["EQUIVALENT_SCOPE","NESTED_COMPATIBLE_SCOPE"],
    "outros": "qualquer"
  },
  "evidence_equality": "set(left_evidence_refs_checked) == set(refs fornecidas do lado LEFT); idem RIGHT. Acrescimo, omissao ou estrangeira = INVALID."
}
