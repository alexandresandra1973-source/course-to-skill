{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SOURCE-LOCAL-EXTRACTION-BUNDLE v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "slice_id", "raw_claims", "raw_candidates"],
  "properties": {
    "source_id": {"enum": ["MS001-SRC-B", "MS001-SRC-C"]},
    "slice_id": {"type": "string", "pattern": "^SL-[BC]-[0-9]{2}$"},
    "raw_claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["temporary_claim_id","text","source_language","evidence_refs","qualifiers","status"],
        "properties": {
          "temporary_claim_id": {"type":"string","pattern":"^TC-[0-9]{3}$"},
          "text": {"type":"string","minLength":10},
          "source_language": {"enum":["pt"]},
          "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^EV-[0-9]{4}$"}},
          "qualifiers": {
            "type":"object","additionalProperties": false,
            "properties": {
              "scope": {"type":["string","null"]},
              "condition": {"type":["string","null"]},
              "platform": {"type":["string","null"]},
              "stage": {"type":["string","null"]},
              "audience": {"type":["string","null"]}
            }
          },
          "status": {"enum":["SOURCE_EXPLICIT","SOURCE_IMPLIED"]}
        }
      }
    },
    "raw_candidates": {
      "type": "array",
      "items": {
        "type":"object","additionalProperties": false,
        "required": ["temporary_candidate_id","entity_kind","evidence_refs","claim_temp_refs","structure","defects"],
        "properties": {
          "temporary_candidate_id": {"type":"string","pattern":"^TX-[0-9]{3}$"},
          "entity_kind": {"enum":["rule_candidate","workflow_candidate","anti_pattern_candidate"]},
          "evidence_refs": {"type":"array","minItems":1,"items":{"type":"string","pattern":"^EV-[0-9]{4}$"}},
          "claim_temp_refs": {"type":"array","items":{"type":"string","pattern":"^TC-[0-9]{3}$"}},
          "claim_refs_applicability": {"enum":["APPLICABLE","NOT_APPLICABLE"]},
          "defects": {"type":"array","items":{"enum":["PRECEDENCE_UNDEFINED","PASSO_UNICO","SCOPE_UNSTATED"]}},
          "structure": {
            "oneOf": [
              {"type":"object","additionalProperties":false,
               "required":["name","trigger","condition","action","do_not","precedence"],
               "properties":{"name":{"type":"string"},"trigger":{"type":"string"},
                 "condition":{"type":"string"},"action":{"type":"string"},
                 "do_not":{"type":"array","items":{"type":"string"}},
                 "precedence":{"type":["string","null"]},
                 "exceptions":{"type":"array","items":{"type":"string"}},
                 "prerequisites":{"type":"array","items":{"type":"string"}}}},
              {"type":"object","additionalProperties":false,
               "required":["name","steps"],
               "properties":{"name":{"type":"string"},
                 "steps":{"type":"array","minItems":1,"items":{
                   "type":"object","additionalProperties":false,
                   "required":["order_key","name","action","evidence_refs"],
                   "properties":{"order_key":{"type":"integer","minimum":1},
                     "name":{"type":"string"},"action":{"type":"string"},
                     "required_inputs":{"type":"array","items":{"type":"string"}},
                     "missing_input_action":{"type":["string","null"]},
                     "evidence_refs":{"type":"array","minItems":1,
                       "items":{"type":"string","pattern":"^EV-[0-9]{4}$"}}}}},
                 "exceptions":{"type":"array","items":{"type":"string"}},
                 "prerequisites":{"type":"array","items":{"type":"string"}}}},
              {"type":"object","additionalProperties":false,
               "required":["do_not","why"],
               "properties":{"do_not":{"type":"array","minItems":1,"items":{"type":"string"}},
                 "why":{"type":"string"},
                 "conditions":{"type":"array","items":{"type":"string"}}}}
            ]
          }
        }
      }
    }
  }
}
